# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration
DB_DRIVER=mysql
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=utf8mb4
DB_PREFIX=

# For API
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Aiven MySQL requires TLS. Set DB_SSL=true when using Aiven.
# Optional: DB_SSL_CA = path to Aiven's ca.pem to verify the server certificate.
DB_SSL=false
DB_SSL_CA=

# Generate JWT_SECRET and REFRESH_TOKEN_KEY with:  php lava jwt:generate
# (they must be different, 32+ random characters)

# CORS: your frontend URL(s), comma separated. Use * only for local development.
ALLOW_ORIGIN=*

# The /migrate, /rollback, /refresh ... routes are public. Set to false on the
# deployed server once your tables exist.
MIGRATION_ENABLED=true
